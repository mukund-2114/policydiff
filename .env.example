# Copy to .env and fill in. Never commit .env.

POSTGRES_USER=policydiff
POSTGRES_PASSWORD=change-me
POSTGRES_DB=policydiff

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# First admin account, created on startup only if no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Model provider keys. Only the provider chosen in models.yaml is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only needed if models.yaml sets rerank.provider to cohere.
COHERE_API_KEY=

# Amazon Bedrock only: the region. Credentials come from an IAM role or the usual AWS variables.
AWS_REGION=

# Set to true once the app is served over HTTPS (see the README, "Put it on a server").
COOKIE_SECURE=false

# Must match the embedding model's output size (text-embedding-3-small = 1536).
EMBED_DIMS=1536

# File storage. "local" keeps PDFs in a Docker volume. For a bucket, set STORAGE_BACKEND=s3 and
# S3_BUCKET; add S3_ENDPOINT_URL for MinIO or R2, and S3_ACCESS_KEY / S3_SECRET_KEY unless the
# machine has an IAM role.
STORAGE_BACKEND=local

# Production only (deploy/docker-compose.prod.yml, see deploy/DEPLOY.md).
# IMAGE_OWNER is the GitHub account that published the images; IMAGE_TAG is the version to run.
IMAGE_OWNER=mukund-2114
IMAGE_TAG=latest
# HTTPS, pick one. Caddy: set DOMAIN (the subdomain) and COMPOSE_PROFILES=caddy.
# Cloudflare Tunnel: set TUNNEL_TOKEN and COMPOSE_PROFILES=tunnel.
DOMAIN=
TUNNEL_TOKEN=
COMPOSE_PROFILES=
